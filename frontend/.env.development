# Development Environment Variables
# This file is automatically loaded in development mode

# App metadata
VITE_APP_NAME=Embla (Dev)
VITE_APP_ENV=development

# API requests go to '/api' and are forwarded to Django by the Vite dev
# server proxy (see vite.config.ts). Set VITE_API_URL only to bypass the
# proxy and call a remote API directly.
# VITE_API_URL=http://localhost:8000/api

# Where the Vite dev proxy forwards /api requests.
# docker-compose.local.yml overrides this with http://django:8000.
VITE_API_PROXY_TARGET=http://localhost:8000

# Development Settings
VITE_DEBUG=true
VITE_ENABLE_DEV_TOOLS=true
