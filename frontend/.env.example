# Frontend Environment Variables
# Copy this file to .env.development or .env.production and fill in values

# App metadata
VITE_APP_NAME=Embla
VITE_APP_ENV=development

# API requests go to '/api' and are forwarded to Django by the Vite dev
# server proxy (development) or nginx (production). Set VITE_API_URL only
# to bypass the proxy and call a remote API directly.
# VITE_API_URL=http://localhost:8000/api

# Where the Vite dev proxy forwards /api requests (development only).
VITE_API_PROXY_TARGET=http://localhost:8000

# CSRF cookie name — must match Django's CSRF_COOKIE_NAME
# ('__Secure-csrftoken' in production, 'csrftoken' otherwise).
# VITE_CSRF_COOKIE_NAME=csrftoken

# Development Settings
VITE_DEBUG=true
VITE_ENABLE_DEV_TOOLS=true

# Feature Flags (optional)
# VITE_ENABLE_FEATURE_X=true
# VITE_ENABLE_FEATURE_Y=false
